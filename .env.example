# Copy to .env and fill in. Never commit .env.

# --- Wallet / network (scripts/run_miner.sh) ---
WALLET_NAME=miner
WALLET_HOTKEY=default
NETWORK=finney          # or: test
NETUID=54               # 322 on testnet
AXON_PORT=8091          # open this TCP port to the internet
# EXTERNAL_IP=1.2.3.4   # only if auto-detection is wrong

# --- Image backend ---
# auto (default): local GPU if CUDA is present, else hosted if a key is set
MIID_BACKEND=hosted

# Hosted (CPU-only) backend: any OpenAI-compatible chat-completions endpoint
# that returns images. Default provider: OpenRouter.
MIID_HOSTED_API_KEY=
# MIID_HOSTED_BASE_URL=https://openrouter.ai/api/v1
# MIID_HOSTED_MODEL=google/gemini-2.5-flash-image
MIID_HOSTED_DAILY_USD=1.00        # hard daily spend cap (UTC day); 0 disables generation
# MIID_HOSTED_CONCURRENCY=3
# MIID_HOSTED_TIMEOUT=90
# MIID_HOSTED_COST_PER_IMAGE=0.04 # used only if the provider reports no cost

# Local GPU backend (requirements-gpu.txt)
# HF_TOKEN=
# MIID_MODEL=flux_klein

# --- Identity pre-check (scripts/setup_adaface.sh) ---
MIID_FACE_CHECK=auto              # auto | on | off

# --- Submission ---
# MIID_S3_RETRIES=3
# MIID_EXTRA_VALIDATORS=          # comma-separated validator hotkeys to accept besides the built-in list
